# Copie ce fichier en .env sur le serveur : cp .env.example .env
# Port d'écoute sur le serveur Ubuntu -> http://IP-DU-SERVEUR:8088
APP_PORT=8088

# Identifiants PostgreSQL (utilisés uniquement à l'intérieur du réseau Docker)
POSTGRES_USER=bouture
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=bouture

TZ=Europe/Brussels
